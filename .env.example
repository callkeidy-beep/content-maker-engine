# 이 파일을 .env로 복사해서 값을 채운다. .env는 Git에 올리지 않는다.

# 네이버 메일
NAVER_ADDRESS=yourname@naver.com
NAVER_APP_PASSWORD=

# 다음 메일
DAUM_ADDRESS=yourname@daum.net
DAUM_APP_PASSWORD=

# AI
AI_PROVIDER=anthropic          # anthropic | openai | google | none
ANTHROPIC_API_KEY=
AI_MODEL=                      # 비워 두면 Claude가 공식 문서 기준 권장 모델을 제안
OPENAI_API_KEY=
GOOGLE_API_KEY=

# 앱
APP_SECRET_KEY=                # 로그인 세션·저장 암호화용 임의 문자열
APP_ADMIN_PASSWORD=
DATABASE_URL=sqlite:///data/engine.db

# 백업
BACKUP_REMOTE=none             # none | gdrive | dropbox
GDRIVE_FOLDER_ID=
DROPBOX_TOKEN=
