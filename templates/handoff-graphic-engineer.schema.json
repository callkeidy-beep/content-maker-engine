{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "그래픽 엔지니어로 넘기는 형식",
  "type": "object",
  "required": ["version", "source", "tables"],
  "properties": {
    "version": {"const": "1.0"},
    "source": {"const": "content-maker-engine"},
    "article_id": {"type": ["string", "null"]},
    "article_title": {"type": ["string", "null"]},
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "kind", "columns", "rows", "source_note"],
        "properties": {
          "title": {"type": "string"},
          "kind": {"enum": ["summary_table", "bar", "pie", "line", "candle", "sankey"]},
          "columns": {"type": "array", "items": {"type": "string"}},
          "rows": {"type": "array", "items": {"type": "array"}},
          "unit": {"type": ["string", "null"]},
          "number_style": {"const": "korean", "description": "몇 억 몇 만 순서 표기"},
          "source_note": {"type": "string"},
          "source_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
