{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "카드뉴스 원고",
  "type": "object",
  "required": ["article_id", "ratio", "slides", "disclosure"],
  "properties": {
    "article_id": {"type": "string"},
    "publication": {"type": "string"},
    "ratio": {"enum": ["1:1", "4:5"]},
    "slides": {
      "type": "array", "minItems": 4, "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["no", "role", "title"],
        "properties": {
          "no": {"type": "integer", "minimum": 1},
          "role": {"enum": ["cover", "fact", "detail", "number", "closing"]},
          "title": {"type": "string", "maxLength": 22},
          "body": {"type": "string", "maxLength": 70},
          "number": {"type": ["object", "null"],
            "properties": {"value": {"type": "string"}, "unit": {"type": "string"}, "label": {"type": "string"}}},
          "photo_id": {"type": ["string", "null"]},
          "caption": {"type": ["string", "null"]},
          "credit": {"type": ["string", "null"]},
          "source_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "hashtags": {"type": "array", "items": {"type": "string"}, "maxItems": 10},
    "post_caption": {"type": "string", "maxLength": 2200},
    "disclosure": {"type": "string"},
    "template_id": {"type": ["string", "null"], "description": "디자인 제공 후 사용"}
  }
}
